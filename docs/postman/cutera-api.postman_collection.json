{
  "info": {
    "_postman_id": "c7e01a3b-1b2e-4f4b-9e2b-cutera-api-0001",
    "name": "Cutera API",
    "description": "Backend API collection for the Cutera admin + mobile clients.\n\n## How to use\n\n1. Import this collection into Postman.\n2. Set `base_url` in **Collection Variables** (already defaults to `http://cutera-upgradation.test` for local dev).\n3. Run **Auth → Login** once with a real admin email/password — the post-response script stores `access_token` + `refresh_token` on the collection.\n4. Every other request inherits `Authorization: Bearer {{access_token}}` from collection-level auth.\n5. Access tokens expire in 15 minutes; run **Auth → Refresh** to rotate without re-entering credentials.\n\n## Scope\n\n- Auth (Passport password grant — v2)\n- Application Users (CRUD, status, password change)\n- Roles (CRUD + duplicate)\n- Permissions (CRUD + parent groups)\n\nMore modules will be appended as they're requested.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://cutera-upgradation.test",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Passport password-grant auth. Login stores access + refresh tokens on the collection so every other request authenticates automatically.",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"secret\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "login"]
            },
            "description": "Exchanges email + password for a Passport access/refresh pair. Rate-limited 5/min.\n\nResponse `data`: `{ access_token, refresh_token, expires_in, token_type, user }`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
                  "  console.log('Stored access + refresh tokens on collection.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "refresh"]
            },
            "description": "Rotates the access + refresh token pair. Rate-limited 10/min."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
                  "  console.log('Refreshed access + refresh tokens.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "logout"]
            },
            "description": "Revokes the current access token and its refresh chain."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Application (staff/admin) users — CRUD, status toggle, password change.\n\n`/api/users/datatable` returns a DataTables-style payload outside the standard envelope; on the SPA side call `api.post(path, body, { raw: true })`.",
      "item": [
        {
          "name": "List (datatable)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"draw\": 1,\n  \"start\": 0,\n  \"length\": 10,\n  \"search\": { \"value\": \"\" },\n  \"order\": [{ \"column\": 0, \"dir\": \"asc\" }]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/datatable",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "datatable"]
            },
            "description": "Paginated list with filters. Permission: `users_manage`."
          }
        },
        {
          "name": "Create — dropdowns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/users/create",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "create"]
            },
            "description": "Returns roles, locations, warehouses, user types needed to render the create form. Permission: `users_create`."
          }
        },
        {
          "name": "Create — submit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@example.com\",\n  \"password\": \"Str0ng!Pass\",\n  \"phone\": \"+923001234567\",\n  \"gender\": 1,\n  \"roles\": [1],\n  \"centers\": [1],\n  \"warehouse\": [],\n  \"hr_managed\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            },
            "description": "Password must be 8+ chars with upper, lower, digit, and special char. Permission: `users_create`."
          }
        },
        {
          "name": "Edit — fetch",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/users/:user/edit",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ":user", "edit"],
              "variable": [{ "key": "user", "value": "1" }]
            },
            "description": "User data + dropdowns for the edit form. Permission: `users_edit`."
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User (edited)\",\n  \"email\": \"test.user@example.com\",\n  \"phone\": \"+923001234567\",\n  \"gender\": 1,\n  \"roles\": [1],\n  \"centers\": [1],\n  \"warehouse\": [],\n  \"hr_managed\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/:user",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ":user"],
              "variable": [{ "key": "user", "value": "1" }]
            },
            "description": "Full user update. `email`, `phone`, `gender` required on PUT/PATCH. Permission: `users_edit`."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/users/:user",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ":user"],
              "variable": [{ "key": "user", "value": "1" }]
            },
            "description": "Soft-delete user. Permission: `users_destroy`."
          }
        },
        {
          "name": "Toggle status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"status\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/status",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "status"]
            },
            "description": "Activate (status=1) or deactivate (status=0) a user. Permission: `users_active`."
          }
        },
        {
          "name": "Change password — fetch form",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/users/password/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "password", ":id"],
              "variable": [{ "key": "id", "value": "1", "description": "Encrypted user id — obtain from a previous endpoint, not the raw integer in production." }]
            },
            "description": "Returns the encrypted id used by the PATCH below. Permission: `users_change_password`."
          }
        },
        {
          "name": "Change password — save",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{encrypted_user_id}}\",\n  \"password\": \"Str0ng!NewPass\",\n  \"password_confirmation\": \"Str0ng!NewPass\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/password",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "password"]
            },
            "description": "⚠️ Current known auth gap: no re-auth / current_password check. Permission: `users_change_password`."
          }
        }
      ]
    },
