# Copy to .env.local and uncomment entries to override the Vite build.

# Dev proxy: Vite forwards /api/* to this upstream when running `npm run dev`.
# Leave unset to default to http://localhost:8000 (Laravel's `php artisan serve`
# port). For Herd, point this at your local site domain.
# VITE_API_PROXY_TARGET=http://cutera-upgradation.test

# API base URL (prefixed to every fetch path that doesn't start with http).
# Leave unset for same-origin calls; set to the production API origin when the
# SPA is served from a different host.
# VITE_API_BASE_URL=

# Auth mode — 'cookie' (default, Sanctum SPA mode) or 'bearer' (legacy).
#
# cookie  — Laravel session cookie (HttpOnly, SameSite=lax). XSS cannot
#           read the cookie. Login sends `client=web` so the server
#           doesn't issue a PAT. This is the default as of 2026-04-18.
#
# bearer  — Sanctum PAT stored in sessionStorage, attached as
#           Authorization: Bearer …. XSS on the SPA origin can read the
#           token. Only needed for the mobile-app client or for
#           temporarily rolling back a cookie-mode deploy.
#
# Rebuild the SPA (`npm run build`) after changing. Server-side flag
# at `config('features.spa_cookie_auth')` mirrors this for clarity.
# VITE_AUTH_MODE=bearer
