# =============================================================================
# Cutera CRM environment template.
#
# Defaults in this file are PRODUCTION-SAFE — `APP_ENV=production`,
# `APP_DEBUG=false`, `SESSION_SECURE_COOKIE=true` etc. Local-dev overrides
# (laragon, valet) belong only in your real `.env`. Before promoting any
# environment to production, diff your `.env` against this template and
# justify every divergence — particularly the four below, which leak
# information when wrong:
#
#   APP_ENV               must be `production`
#   APP_DEBUG             must be `false`         (prevents stack traces)
#   LOG_LEVEL             should be `warning`     (debug = noisy + slow)
#   SESSION_SECURE_COOKIE must be `true`          (HTTPS cookie scoping)
# =============================================================================

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

SESSION_SECURE_COOKIE=true

LOG_CHANNEL=daily
# `warning` is the minimum recommended level in production. `debug` and
# `info` produce verbose logs that may include PII (request payloads,
# query bindings) and accelerate disk pressure on busy nodes.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# -----------------------------------------------------------------------------
# Test database (PHPUnit / CI). Used by config/database.php `mysql_testing`
# connection. MUST be a separate, throwaway database. See tests/README.md.
# -----------------------------------------------------------------------------
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=cutera_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=
# M4 — Enable TLS to MariaDB in production. When app and DB run on
# different hosts (anything beyond a single-VM dev setup) the connection
# carries credentials and PII in cleartext unless this is set. The path
# must be readable by the PHP process. Recommended companion change on
# the DB side: `ALTER USER 'cutera_app'@'%' REQUIRE SSL`.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/mysql-ca.pem

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Security: bcrypt cost (10 = Laravel default; 12 = current OWASP guidance)
BCRYPT_ROUNDS=12

# H4 — CORS allowlist. Comma-separated list of full origins permitted
# to call /api/*. Leave empty to reject ALL cross-origin requests
# (the safe default). NEVER set this to '*'.
# Example:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SMS Operator Credentials
SMS_TELENOR_USERNAME=
SMS_TELENOR_PASSWORD=
SMS_JAZZ_USERNAME=
SMS_JAZZ_PASSWORD=

# Meta Conversion API Configuration
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v18.0
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=true
