{
    // Mutation testing = the teeth check (TESTING.md sec.5). Scoped via --filter in
    // `composer test:mutation` to the critical modules from the invariant map -- a
    // bare `infection` run would mutate ALL of app/ (slow), so ALWAYS use the
    // composer script. Needs a coverage driver (pcov/xdebug): CI installs pcov;
    // locally run `pecl install pcov` first.
    //
    // thresholds are a RATCHET. These are the BOOTSTRAP FLOOR for the first gating
    // runs (no coverage driver exists locally -- pcov is CI-only -- so the first
    // green CI run on `backend` IS the calibration run): low enough to pass, high
    // enough to catch catastrophic test-gutting. As soon as CI reports the real
    // MSI, raise both to just below it. From then on NEVER lower a threshold to
    // go green -- harden the tests instead.
    // threads=1 in composer test:mutation is deliberate: mutant test runs share
    // ONE mariadb_testing DB (RefreshDatabase has no per-thread isolation), so
    // parallel runs interleave and produce flaky verdicts. Don't raise it without
    // giving each thread its own DB.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app"]
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 15,
    "minCoveredMsi": 40,
    "tmpDir": "build/infection",
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html"
    },
    "testFramework": "phpunit"
}
