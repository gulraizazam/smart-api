    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.php) [ -x vendor/bin/pint ] && vendor/bin/pint \"$f\" >/dev/null 2>&1 ;; esac; } || true",
            "statusMessage": "Pint"
          }
        ]
      }
    ]
  }
}
